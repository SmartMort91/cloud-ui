 .github/workflows/beta_build.yml              | 84 +++++++++++++++++++
 CUSTOM_UI.md                                  |  7 ++
 app/build.gradle.kts                          |  6 +-
 .../cloudstream3/MainActivityScreen.kt        |  5 +-
 app/src/prerelease/res/values/strings.xml     |  4 +-
 5 files changed, 102 insertions(+), 4 deletions(-)
