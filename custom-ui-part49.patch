From eaf633e56a157c10680b15792bd48184adb48668 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 4 Nov 2026 09:29:43 -0500
Subject: [PATCH] Collections: own GitHub Pages redirect for share links

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_014qZCVttpTLPabm2EDtLLMw
---
 CUSTOM_UI.md                                  |  2 +-
 .../cloudstream3/utils/CustomCollections.kt   | 15 +++++---
 docs/index.html                               | 38 +++++++++++++++++++
 3 files changed, 49 insertions(+), 6 deletions(-)
 create mode 100644 docs/index.html

diff --git a/CUSTOM_UI.md b/CUSTOM_UI.md
index a632816..abb0f17 100644
--- a/CUSTOM_UI.md
+++ b/CUSTOM_UI.md
@@ -66,7 +66,7 @@ is Off. If a page has a bottom element hidden behind the pill, it is probably no
   delete, share, import).
 * Sharing: `encodeLink`/`decodeLink` turn a collection into `cscollection://<gzip+base64url JSON>`. The manifest has a
   `cscollection` intent filter and `MainActivity.handleAppIntent` calls `importFromText`. The share text also
-  contains an `https://recloudstream.github.io/csredirect?redirectto=...` link (tappable in chat apps) and the raw link
+  contains an `https://<owner>.github.io/<repo>/?c=...` link (tappable in chat apps; served from `docs/index.html` via GitHub Pages, which must be enabled once: Settings > Pages > main /docs) and the raw link
   for pasting via Library > Collections > Import from link. Imports ask first and rename on name clashes.
 
 ### Themes
diff --git a/app/src/main/java/com/lagradost/cloudstream3/utils/CustomCollections.kt b/app/src/main/java/com/lagradost/cloudstream3/utils/CustomCollections.kt
index 9ed5769..1e78811 100644
--- a/app/src/main/java/com/lagradost/cloudstream3/utils/CustomCollections.kt
+++ b/app/src/main/java/com/lagradost/cloudstream3/utils/CustomCollections.kt
@@ -6,6 +6,7 @@ import android.content.Context
 import android.content.Intent
 import android.util.Base64
 import android.text.InputType
+import com.lagradost.cloudstream3.BuildConfig
 import com.lagradost.cloudstream3.CloudStreamApp.Companion.getKey
 import com.lagradost.cloudstream3.CloudStreamApp.Companion.setKey
 import com.lagradost.cloudstream3.CommonActivity.showToast
@@ -22,7 +23,6 @@ import org.json.JSONArray
 import org.json.JSONObject
 import java.io.ByteArrayInputStream
 import java.io.ByteArrayOutputStream
-import java.net.URLEncoder
 import java.util.zip.GZIPInputStream
 import java.util.zip.GZIPOutputStream
 
@@ -151,7 +151,10 @@ object CustomCollections {
     // ----- Sharing -----
 
     const val LINK_SCHEME = "cscollection"
-    private val linkRegex = Regex("""cscollection(?:://|%3A%2F%2F)([A-Za-z0-9_-]+)""", RegexOption.IGNORE_CASE)
+    private val linkRegex = Regex(
+        """cscollection(?:://|%3A%2F%2F)([A-Za-z0-9_-]+)|\.github\.io/[^\s?]*\?c=([A-Za-z0-9_-]+)""",
+        RegexOption.IGNORE_CASE
+    )
 
     /** Compact gzip + base64url encoding so a whole collection fits in a link */
     fun encodeLink(c: Collection): String {
@@ -180,7 +183,8 @@ object CustomCollections {
 
     /** Finds a collection link anywhere in [text] (raw link or the https redirect form) */
     fun decodeLink(text: String): Collection? {
-        val payload = linkRegex.find(text)?.groupValues?.getOrNull(1) ?: return null
+        val m = linkRegex.find(text) ?: return null
+        val payload = (m.groupValues[1].ifEmpty { m.groupValues[2] }).ifEmpty { return null }
         return runCatching {
             val bytes = Base64.decode(payload, Base64.URL_SAFE or Base64.NO_WRAP)
             val json = GZIPInputStream(ByteArrayInputStream(bytes)).use {
@@ -222,8 +226,9 @@ object CustomCollections {
 
     fun Activity.shareCollection(c: Collection) {
         val link = encodeLink(c)
-        val redirect = "https://recloudstream.github.io/csredirect?redirectto=" +
-            URLEncoder.encode(link, "UTF-8")
+        // Tiny redirect page in this repo's own GitHub Pages (docs/index.html)
+        val redirect = "https://${BuildConfig.UPDATE_REPO_OWNER.lowercase()}.github.io/" +
+            "${BuildConfig.UPDATE_REPO_NAME}/?c=${link.substringAfter("://")}"
         val text = getString(R.string.collection_share_text, c.name, c.items.size) +
             "\n" + redirect + "\n\n" +
             getString(R.string.collection_share_fallback) + "\n" + link
diff --git a/docs/index.html b/docs/index.html
new file mode 100644
index 0000000..11849c4
--- /dev/null
+++ b/docs/index.html
@@ -0,0 +1,38 @@
+<!doctype html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<title>Open collection in CloudStream Custom</title>
+<style>
+  body{font-family:system-ui,sans-serif;background:#0b0d14;color:#eee;margin:0;padding:24px;text-align:center}
+  main{max-width:480px;margin:10vh auto 0}
+  a.btn{display:inline-block;margin:20px 0;padding:14px 28px;border-radius:999px;background:#fff;color:#000;font-weight:600;text-decoration:none}
+  textarea{width:100%;height:90px;background:#151826;color:#ccc;border:1px solid #333;border-radius:12px;padding:8px;box-sizing:border-box}
+  p{color:#aaa;line-height:1.5}
+</style>
+</head>
+<body>
+<main>
+  <h1>Shared collection</h1>
+  <p id="msg">Opening CloudStream Custom…</p>
+  <a class="btn" id="open" href="#">Open in app</a>
+  <p>Nothing happens? Make sure CloudStream Custom is installed on this phone and use the button above.
+     You can also copy this link and paste it in the app under Library &gt; Collections &gt; Import from link.</p>
+  <textarea id="raw" readonly></textarea>
+</main>
+<script>
+  var c = new URLSearchParams(location.search).get("c");
+  if (c && /^[A-Za-z0-9_-]+$/.test(c)) {
+    var link = "cscollection://" + c;
+    document.getElementById("open").href = link;
+    document.getElementById("raw").value = link;
+    setTimeout(function () { location.href = link; }, 300);
+  } else {
+    document.getElementById("msg").textContent = "This link is missing its collection data.";
+    document.getElementById("open").style.display = "none";
+    document.getElementById("raw").style.display = "none";
+  }
+</script>
+</body>
+</html>
