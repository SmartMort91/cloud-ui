From 6e6fd6e9f4237c8457c3df98227723466c0f7c6c Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 3 Nov 2026 22:10:20 -0500
Subject: [PATCH] Updater: always use legacy installer, show session install
 failure reason

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_014qZCVttpTLPabm2EDtLLMw
---
 .../com/lagradost/cloudstream3/utils/InAppUpdater.kt  |  4 +++-
 .../lagradost/cloudstream3/utils/PackageInstaller.kt  | 11 +++++++++++
 2 files changed, 14 insertions(+), 1 deletion(-)

diff --git a/app/src/main/java/com/lagradost/cloudstream3/utils/InAppUpdater.kt b/app/src/main/java/com/lagradost/cloudstream3/utils/InAppUpdater.kt
index 18ace57..00abd34 100644
--- a/app/src/main/java/com/lagradost/cloudstream3/utils/InAppUpdater.kt
+++ b/app/src/main/java/com/lagradost/cloudstream3/utils/InAppUpdater.kt
@@ -316,7 +316,9 @@ object InAppUpdater {
                             getString(R.string.apk_installer_key), 1
                         )
 
-                        when (currentInstaller) {
+                        // Custom fork: the session installer fails on some devices with
+                        // "App not installed", so always use the legacy installer here.
+                        when (if (currentInstaller == 0) 1 else currentInstaller) {
                             // New method
                             0 -> {
                                 val intent = PackageInstallerService.Companion.getIntent(
diff --git a/app/src/main/java/com/lagradost/cloudstream3/utils/PackageInstaller.kt b/app/src/main/java/com/lagradost/cloudstream3/utils/PackageInstaller.kt
index 67851f6..6806dd1 100644
--- a/app/src/main/java/com/lagradost/cloudstream3/utils/PackageInstaller.kt
+++ b/app/src/main/java/com/lagradost/cloudstream3/utils/PackageInstaller.kt
@@ -67,6 +67,17 @@ class ApkInstaller(private val service: PackageInstallerService) {
                     userAction?.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
                     context.startActivity(userAction)
                 }
+                PackageInstaller.STATUS_SUCCESS -> Unit
+                else -> {
+                    val msg = intent.getStringExtra(PackageInstaller.EXTRA_STATUS_MESSAGE)
+                    android.os.Handler(android.os.Looper.getMainLooper()).post {
+                        android.widget.Toast.makeText(
+                            context,
+                            "Install failed: ${msg ?: "unknown error"}. Use Settings > Updates > APK Installer > Legacy.",
+                            android.widget.Toast.LENGTH_LONG
+                        ).show()
+                    }
+                }
             }
         }
     }
-- 
