new file mode 100644
index 0000000..ace502b
--- /dev/null
+++ b/.github/workflows/custom_release.yml
@@ -0,0 +1,151 @@
+name: Sync CloudStream and publish
+
+# Every day (and on demand) this brings the newest official CloudStream into this repo while
+# keeping the custom UI, then builds a signed APK and publishes it as the "pre-release"
+# release. The app's built-in updater reads that release, so installed copies update themselves.
+# Pushing your own changes to main also builds and publishes.
+#
+# Needs two repository secrets (Settings > Secrets and variables > Actions):
+#   SIGNING_KEYSTORE_BASE64  the signing key file, base64 encoded
+#   SIGNING_PASSWORD         the password of that key
+
+on:
+  schedule:
+    - cron: '23 5 * * *'
+  workflow_dispatch:
+  push:
+    branches: [ main ]
+    paths-ignore:
+      - '*.md'
+
+permissions:
+  contents: write
+  issues: write
+
+concurrency:
+  group: custom-release
+  cancel-in-progress: false
+
+env:
+  UPSTREAM_REPO: https://github.com/recloudstream/cloudstream.git
+  UPSTREAM_BRANCH: master
+  # Official commit this UI was first written on top of. Only used once, to link the history.
+  BASELINE_SHA: 5024ace2922a148d38df2a816b483b529789cf58
+
+jobs:
+  sync:
+    if: github.event_name != 'push'
+    runs-on: ubuntu-latest
+    outputs:
+      changed: ${{ steps.merge.outputs.changed }}
+    steps:
+      - uses: actions/checkout@v6
+        with:
+          fetch-depth: 0
+          ref: main
+
+      - name: Merge the newest CloudStream
+        id: merge
+        env:
+          GH_TOKEN: ${{ github.token }}
+        run: |
+          git config user.name "github-actions[bot]"
+          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
+          git remote add upstream "$UPSTREAM_REPO"
+          git fetch --no-tags upstream "$UPSTREAM_BRANCH"
+
+          if git merge-base --is-ancestor "upstream/$UPSTREAM_BRANCH" HEAD; then
+            echo "Already up to date with CloudStream."
+            echo "changed=false" >> "$GITHUB_OUTPUT"
+            exit 0
+          fi
+
+          # One time only: this repo started as a copy of CloudStream, so tell git which official
+          # commit it started from. Later merges then keep the custom UI and only bring in what
+          # changed upstream.
+          if ! git merge-base HEAD "upstream/$UPSTREAM_BRANCH" > /dev/null 2>&1; then
+            git merge -s ours --allow-unrelated-histories --no-edit \
+              -m "Link history to CloudStream $BASELINE_SHA" "$BASELINE_SHA"
+          fi
+
+          if ! git merge --no-edit -m "Merge newest CloudStream" "upstream/$UPSTREAM_BRANCH"; then
+            files=$(git diff --name-only --diff-filter=U | sed 's/^/- /')
+            git merge --abort
+            title="CloudStream update needs a manual merge"
+            if [ -z "$(gh issue list --state open --search "$title in:title" --json number --jq '.[0].number')" ]; then
+              body=$(printf 'The newest CloudStream changes overlap with the custom UI in:\n\n%s\n\nAsk Claude to resolve the merge (see CUSTOM_UI.md), then run this workflow again.' "$files")
+              gh issue create --title "$title" --body "$body"
+            fi
+            exit 1
+          fi
+
+          # The workflow token is not allowed to change workflow files, so keep ours
+          if ! git diff --quiet HEAD^1 HEAD -- .github/workflows; then
+            git rm -rfq --ignore-unmatch .github/workflows
+            git checkout HEAD^1 -- .github/workflows
+            git commit --amend --no-edit -q
+          fi
+
+          git push origin HEAD:main
+          echo "changed=true" >> "$GITHUB_OUTPUT"
+
+  build:
+    needs: sync
+    if: >-
+      ${{ always()
+      && (needs.sync.result == 'success' || needs.sync.result == 'skipped')
+      && (github.event_name != 'schedule' || needs.sync.outputs.changed == 'true') }}
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v6
+        with:
+          ref: ${{ github.event_name == 'push' && github.sha || 'main' }}
+
+      - name: Set up JDK 17
+        uses: actions/setup-java@v5
+        with:
+          distribution: temurin
+          java-version: 17
+
+      - name: Grant execute permission for gradlew
+        run: chmod +x gradlew
+
+      - name: Install signing key
+        env:
+          KEYSTORE_BASE64: ${{ secrets.SIGNING_KEYSTORE_BASE64 }}
+          SIGNING_PASSWORD: ${{ secrets.SIGNING_PASSWORD }}
+        run: |
+          if [ -z "$KEYSTORE_BASE64" ] || [ -z "$SIGNING_PASSWORD" ]; then
+            echo "::error::Add the SIGNING_KEYSTORE_BASE64 and SIGNING_PASSWORD repository secrets first. Without a fixed key the app cannot update itself."
+            exit 1
+          fi
+          mkdir -p "$HOME/work/_temp/keystore"
+          echo "$KEYSTORE_BASE64" | base64 -d > "$HOME/work/_temp/keystore/custom-ui.jks"
+
+      - name: Setup Gradle
+        uses: gradle/actions/setup-gradle@v5
+
+      - name: Build signed APK
+        run: ./gradlew assemblePrereleaseRelease
+        env:
+          SIGNING_KEY_ALIAS: customui
+          SIGNING_KEY_PASSWORD: ${{ secrets.SIGNING_PASSWORD }}
+          SIGNING_STORE_PASSWORD: ${{ secrets.SIGNING_PASSWORD }}
+
+      - name: Publish release
+        env:
+          GH_TOKEN: ${{ github.token }}
+        run: |
+          SHA=$(git rev-parse HEAD)
+          gh release delete pre-release --cleanup-tag --yes || true
+          gh release create pre-release app/build/outputs/apk/prerelease/release/*.apk \
+            --target "$SHA" \
+            --prerelease \
+            --title "Custom build" \
+            --notes "Built from commit $SHA. Install the APK. Installed copies update themselves from new releases here."
+
+      - name: Keep a copy of the APK
+        uses: actions/upload-artifact@v7
+        with:
+          name: cloudstream-custom-apk
+          path: app/build/outputs/apk/prerelease/release/*.apk
