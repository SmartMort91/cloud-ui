From aa41f235995fb6c3e761de98bc6497db0b9ad438 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 4 Nov 2026 08:55:08 -0500
Subject: [PATCH] Updater: check SmartMort91/cloud-ui releases, legacy
 installer in Compose updater

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_014qZCVttpTLPabm2EDtLLMw
---
 app/build.gradle.kts                                        | 6 +++---
 .../java/com/lagradost/cloudstream3/MainActivityScreen.kt   | 6 ++----
 .../com/lagradost/cloudstream3/ui/settings/ApkUpdater.kt    | 3 ++-
 3 files changed, 7 insertions(+), 8 deletions(-)

diff --git a/app/build.gradle.kts b/app/build.gradle.kts
index c09a466..d71f29e 100644
--- a/app/build.gradle.kts
+++ b/app/build.gradle.kts
@@ -142,17 +142,17 @@ android {
 
         // The in-app updater checks the GitHub repo the app was built in, so a fork keeps
         // updating itself instead of switching to the official app. Falls back to upstream.
-        val updateRepo = (System.getenv("GITHUB_REPOSITORY") ?: "recloudstream/cloudstream")
+        val updateRepo = (System.getenv("GITHUB_REPOSITORY") ?: "SmartMort91/cloud-ui")
             .split("/")
         buildConfigField(
             "String",
             "UPDATE_REPO_OWNER",
-            "\"" + updateRepo.getOrElse(0) { "recloudstream" } + "\""
+            "\"" + updateRepo.getOrElse(0) { "SmartMort91" } + "\""
         )
         buildConfigField(
             "String",
             "UPDATE_REPO_NAME",
-            "\"" + updateRepo.getOrElse(1) { "cloudstream" } + "\""
+            "\"" + updateRepo.getOrElse(1) { "cloud-ui" } + "\""
         )
         testInstrumentationRunner = "androidx.test.runner.AndroidJUnitRunner"
     }
diff --git a/app/src/main/java/com/lagradost/cloudstream3/MainActivityScreen.kt b/app/src/main/java/com/lagradost/cloudstream3/MainActivityScreen.kt
index 9bab115..48a8c9d 100644
--- a/app/src/main/java/com/lagradost/cloudstream3/MainActivityScreen.kt
+++ b/app/src/main/java/com/lagradost/cloudstream3/MainActivityScreen.kt
@@ -29,8 +29,6 @@ import com.lagradost.cloudstream3.ui.settings.ApkUpdater
 import com.lagradost.cloudstream3.ui.settings.GithubReleases
 import com.lagradost.cloudstream3.ui.settings.GithubReleases.APK_CONTENT_TYPE
 import com.lagradost.cloudstream3.ui.settings.GithubReleases.APK_PRERELEASE
-import com.lagradost.cloudstream3.ui.settings.GithubReleases.APK_REPOSITORY
-import com.lagradost.cloudstream3.ui.settings.GithubReleases.APK_USERNAME
 import com.lagradost.cloudstream3.utils.GitInfo.currentCommitHash
 import com.lagradost.cloudstream3.utils.parseMarkdown
 import com.lagradost.cloudstream4.compose.BlackButton
@@ -58,8 +56,8 @@ object MainActivityScreen : Screen {
         val settings = rememberAppSettings()
         return viewModel(viewModelStoreOwner = activity) {
             GithubViewModel(
-                remoteUserName = APK_USERNAME,
-                remoteRepository = APK_REPOSITORY,
+                remoteUserName = BuildConfig.UPDATE_REPO_OWNER,
+                remoteRepository = BuildConfig.UPDATE_REPO_NAME,
                 remotePrereleaseTag = APK_PRERELEASE,
                 remoteContentType = APK_CONTENT_TYPE,
                 versionName = BuildConfig.VERSION_NAME,
diff --git a/app/src/main/java/com/lagradost/cloudstream3/ui/settings/ApkUpdater.kt b/app/src/main/java/com/lagradost/cloudstream3/ui/settings/ApkUpdater.kt
index 34fea29..9568b96 100644
--- a/app/src/main/java/com/lagradost/cloudstream3/ui/settings/ApkUpdater.kt
+++ b/app/src/main/java/com/lagradost/cloudstream3/ui/settings/ApkUpdater.kt
@@ -49,7 +49,8 @@ object ApkUpdater : AppUpdater {
             val length = length ?: body.contentLength()
             val readStream = body.byteStream()
 
-            when (settings.updates.apkInstaller.get()) {
+            // Custom fork: session installer fails with "App not installed" on some devices.
+            when (if (settings.updates.apkInstaller.get() == 0) 1 else settings.updates.apkInstaller.get()) {
                 0 -> {
                     packageInstallerDownloader(
                         activity,
